@using UrunTakip.Data.Entities;
@* //Categories sınıfını kullanmak için çağrılıyor *@

@model List<Categories> 
@* yukardaki yapı Modeldir*@

@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <h3>Ürün Listesi</h3>

    </div>
    <div class="col-md-6">
        @* <input type="button" value="EKLE" class="btn btn-success" /> *@
        @Html.ActionLink("EKLE", "CategoryEkle", "Categories", null, new { @class = "btn btn-success " })
    </div>
<div class="row">
    <div class="col-md-6">
        <h3>Kategori Listesi</h3>
    </div>
    <div class="col-md-6">
        @Html.ActionLink("EKLE", "CategoryEkle", "Categories", null, new { @class = "btn btn-success " })
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Kategori Adı</th>
            <th>Açıklama</th>
            <th>Güncelle</th>
            <th>Sil</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryId</td>
                <td>@item.CategoryName</td>
                <td>@(item.Description ?? "-")</td>
                <td>  @Html.ActionLink("Gnc", "CategoryGuncelle", new { id = item.CategoryId }, new { @class = "btn btn-sm btn-warning" })</td>
                <td>  @Html.ActionLink("Sil", "CategorySil", new { id = item.CategoryId }, new { @class = "btn btn-sm btn-danger" })</td>
            </tr>
        }
    </tbody>
</table>