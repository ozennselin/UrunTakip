@model UrunTakip.Data.Entities.Customers

@{
    ViewData["Title"] = "Müşteri Sil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Müşteri Sil</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="CustomerSil" method="post">
            <input type="hidden" asp-for="CustomerID" />

            <div class="form-group">
                <label class="control-label">Firma Adı</label>
                <input value="@Model.CompanyName" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label class="control-label">İlgili Kişi</label>
                <input value="@Model.ContactName" class="form-control" readonly />
            </div>

            <div class="form-group">
                <input type="submit" value="Sil" class="btn btn-danger" />
            </div>

            @ViewBag.silmeDurum
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Listeye Dön</a>
</div>