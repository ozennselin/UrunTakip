@using UrunTakip.DTO.CustomerDTOS

@model List<CustomerListDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <h3>Ürün Listesi</h3>

    </div>
    <div class="col-md-6">
        @* <input type="button" value="EKLE" class="btn btn-success" /> *@
        @Html.ActionLink("EKLE", "CustomerEkle", "Musteriler", null, new { @class = "btn btn-success " })
    </div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>CustomerID</th>
            <th>CompanyName</th>
            <th>ContactName</th>
            <th>City</th>
            <th>Güncelle</th>
            <th>Sil</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerID</td>
                <td>@item.CompanyName</td>
                <td>@item.ContactName</td>
                <td>@item.City</td>
                <td>  @Html.ActionLink("Gnc", "CustomerGuncelle", new { id = item.CustomerID }, new { @class = "btn btn-sm btn-warning" })</td>
                <td>  @Html.ActionLink("Sil", "CustomerSil", new { id = item.CustomerID }, new { @class = "btn btn-sm btn-danger" })</td>
            </tr>
        }
    </tbody>
</table>
